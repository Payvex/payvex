{
  "name": "@payvex/sdk",
  "version": "0.1.0",
  "description": "SDK TypeScript oficial para integrar sistemas externos a API Payvex.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "payvex",
    "payments",
    "pix",
    "webhooks",
    "sdk"
  ],
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
