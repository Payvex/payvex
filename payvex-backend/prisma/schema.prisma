generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String        @id @default(cuid())
  name         String
  postalCode   String
  address      String
  neighborhood String
  State        String
  City         String
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  filiais      Filial[]
  subscription Subscription?
  users        User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  companyId    String
  filialId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  filial       Filial?  @relation(fields: [filialId], references: [id], onDelete: SetNull)
}

model Filial {
  id                            String        @id @default(cuid())
  name                          String
  cnpj                          String        @unique
  stripePublicKey               String?
  stripeSecretKey               String?
  stripeWebhookSecret           String?
  mercadoPagoAccessToken        String?
  mercadoPagoWebhookSecret      String?
  pagarMeAccessToken            String?
  pagarMePublicKey              String?
  pagarBankPrivateKey           String?
  pagarBankSandbox              Boolean       @default(false)
  asaasApiKey                   String?
  asaasWebhookToken             String?
  asaasSandbox                  Boolean       @default(false)
  cieloMerchantId               String?
  cieloMerchantKey              String?
  cieloWebhookHeaderKey         String?
  cieloWebhookHeaderValue       String?
  cieloSandbox                  Boolean?      @default(false)
  stoneApiKey                   String?
  stoneClientId                 String?
  stoneSecret                   String?
  stoneSandbox                  Boolean       @default(false)
  nowPaymentsApiKey             String?
  nowPaymentsIpnSecret          String?
  coinbaseCommerceApiKey        String?
  coinbaseCommerceWebhookSecret String?
  bitPayToken                   String?
  bitPaySandbox                 Boolean       @default(false)
  picPayPublicKey               String?
  picPayClientId                String?
  picPayClientSecret            String?
  picPaySellerToken             String?
  pagSeguroEmail                String?
  pagSeguroToken                String?
  pagSeguroSalt                 String?
  pagSeguroSandbox              Boolean?      @default(false)
  preferredGateway              String?
  companyId                     String
  company                       Company       @relation(fields: [companyId], references: [id])
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  bairro                        String?
  cep                           String?
  cidade                        String?
  isActive                      Boolean       @default(true)
  logradouro                    String?
  uf                            String?       @db.VarChar(2)
  woocommerceUrl                String?
  woocommerceConsumerKey        String?
  woocommerceConsumerSecret     String?
  nuvemShopUrl                  String?
  nuvemShopAccessToken          String?
  nuvemShopStoreId              String?
  shopifyUrl                    String?
  shopifyAccessToken            String?
  shopifyStoreId                String?
  shopifyApiVersion             String?       @default("2024-01")
  mercadoPagoTestMode           Boolean       @default(false)
  apiKeys                       ApiKey[]
  transactions                  Transaction[]
  users                         User[]

  @@index([companyId])
}

model ApiKey {
  id            String   @id @default(cuid())
  name          String
  key           String   @unique
  filialId      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  webhookUrl    String?
  webhookSecret String
  filial        Filial   @relation(fields: [filialId], references: [id])
}

model Subscription {
  id                String    @id @default(cuid())
  planName          String    @default("trial")
  status            String    @default("ativo")
  usersLimit        Int       @default(3)
  gatewaysLimit     Int       @default(1)
  transactionsLimit Int       @default(100)
  companyId         String    @unique
  nextRenewalAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  hasAiAnalyst      Boolean   @default(false)
  multiAppLimit     Int       @default(1)
  prioritySupport   Boolean   @default(false)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Transaction {
  id               String            @id @default(cuid())
  amount           Decimal
  netAmount        Decimal?
  fee              Decimal?
  currency         String            @default("BRL")
  installments     Int               @default(1)
  status           TransactionStatus @default(PENDING)
  paymentMethod    PaymentMethod
  customerName     String?
  customerEmail    String?
  customerDocument String?
  gateway          String
  externalId       String            @unique
  paymentUrl       String?
  pixQrCode        String?
  metadata         Json?
  filialId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  filial           Filial            @relation(fields: [filialId], references: [id])

  @@index([filialId])
  @@index([externalId])
  @@index([status])
}

enum Role {
  ADMIN
  USER
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  CRYPTO
}

model WebhookLog {
  id           String    @id @default(cuid())
  provider     String
  eventType    String
  status       String
  externalId   String?
  statusCode   Int?
  errorMessage String?
  payload      Json?
  headers      Json?
  filialId     String
  apiKeyId     String
  createdAt    DateTime  @default(now())
  processedAt  DateTime?
}
